# ─────────────────────────────────────────────────────────────
# Production (Docker)
# For VPS deployment use the root /.env.example and docker-compose.prod.yml
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Public base URL of the API (used in emails, swagger, etc.)
API_BASE_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://tisei:tisei@localhost:5432/tisei?schema=public

# ─────────────────────────────────────────────────────────────
# Redis (BullMQ)
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────
# JWT / Auth
# ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Sliding inactivity window before session forcibly expires (minutes)
SESSION_IDLE_MINUTES=480
# Password reset token TTL (minutes)
PASSWORD_RESET_TTL_MINUTES=60
# 2FA app issuer name shown in authenticator apps
TOTP_ISSUER=Береке ТехСервис CRM

# ─────────────────────────────────────────────────────────────
# CORS — separate origins for landing and CRM
# ─────────────────────────────────────────────────────────────
FRONTEND_CRM_URL=http://localhost:3000
FRONTEND_LANDING_URL=http://localhost:3001
# HTTP по IP без домена: COOKIE_SECURE=false
COOKIE_SECURE=auto
# Дополнительные origin через запятую
CORS_ORIGINS=

# ─────────────────────────────────────────────────────────────
# S3 — AWS (production) or MinIO (local dev, see comments below)
# ─────────────────────────────────────────────────────────────
S3_REGION=us-east-1
S3_BUCKET=tisei-attachments
S3_ACCESS_KEY_ID=your-aws-access-key-id
S3_SECRET_ACCESS_KEY=your-aws-secret-access-key
# For AWS leave empty or use regional endpoint; for MinIO: http://localhost:9000
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Public URL for attachments in CRM (AWS virtual-hosted style or CloudFront)
S3_PUBLIC_URL=https://tisei-attachments.s3.us-east-1.amazonaws.com

# Local MinIO alternative:
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=http://localhost:9000/tisei-attachments

# ─────────────────────────────────────────────────────────────
# Email provider (abstracted — pick one)
# EMAIL_PROVIDER: smtp | sendgrid | mailgun | console
# ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM="Береке ТехСервис CRM <no-reply@tisei.kz>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ─────────────────────────────────────────────────────────────
# Web Push (VAPID) — browser push for CRM web
# ─────────────────────────────────────────────────────────────
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@tisei.kz

# ─────────────────────────────────────────────────────────────
# Firebase Cloud Messaging — native push for mobile app
# Preferred: path to the downloaded service-account JSON file
#   FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/tisei-20-firebase-adminsdk.json
# Alternatives:
#   FIREBASE_SERVICE_ACCOUNT_JSON=<entire JSON as one line>
#   or FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
# Without any of these, in-app /notifications inbox still works; FCM is skipped.
# ─────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private key with literal \n for newlines, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─────────────────────────────────────────────────────────────
# Geocoding / Maps (2GIS primary, abstracted)
# GEO_PROVIDER: twogis | yandex
# ─────────────────────────────────────────────────────────────
GEO_PROVIDER=twogis
TWOGIS_API_KEY=
YANDEX_GEOCODER_API_KEY=
YANDEX_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────
# reCAPTCHA v3 (public request form)
# ─────────────────────────────────────────────────────────────
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# ─────────────────────────────────────────────────────────────
# Rate limiting
# ─────────────────────────────────────────────────────────────
PUBLIC_REQUEST_RATE_MAX=5
PUBLIC_REQUEST_RATE_WINDOW=1 minute
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW=1 minute

# ─────────────────────────────────────────────────────────────
# Soft delete retention (days) for physical cleanup job
# ─────────────────────────────────────────────────────────────
SOFT_DELETE_RETENTION_DAYS=30

# Flutter app path — при старте backend обновляет lib/config/dev_network.dart
TISEI_FLUTTER_DIR=/Users/developer/studioprojects/tisei
