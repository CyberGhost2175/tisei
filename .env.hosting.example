# =============================================================================
# Заливка на VPS БЕЗ домена (по IP). Скопируйте в .env и подставьте значения.
# CRM-фронт на этот сервер не ставится. Визитка + API + (опционально) Telegram-бот.
# =============================================================================

# Публичный IP сервера (из панели хостинга)
PUBLIC_HOST=87.199.130.251

POSTGRES_USER=tisei
POSTGRES_PASSWORD=changeMeOnlyLettersAndDigits
POSTGRES_DB=tisei

# HTTP по IP — без https:// и без домена
API_BASE_URL=http://87.199.130.251:4000
FRONTEND_LANDING_URL=http://87.199.130.251
# CRM на этом сервере нет, но поле обязательное (любой валидный URL)
FRONTEND_CRM_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://87.199.130.251:4000/api/v1
BACKEND_INTERNAL_URL=http://backend:4000/api/v1

# HTTP = cookie без Secure, иначе браузер их отбросит
COOKIE_SECURE=false
CORS_ORIGINS=http://87.199.130.251

NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Подставляются compose'ом, здесь для справки
DATABASE_URL=postgresql://tisei:changeMeOnlyLettersAndDigits@postgres:5432/tisei?schema=public
REDIS_URL=redis://redis:6379

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SESSION_IDLE_MINUTES=480
PASSWORD_RESET_TTL_MINUTES=60
TOTP_ISSUER=Береке ТехСервис CRM

# Первый вход в бот / API (создаётся при старте, если пользователя ещё нет)
BOOTSTRAP_ADMIN_EMAIL=admin@tisei.kz
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisAdminPass1
BOOTSTRAP_ADMIN_NAME=Администратор

# Вложения: пока можно пустыми (фото с визитки не сохранятся, заявка создастся)
S3_REGION=eu-central-1
S3_BUCKET=tisei-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=

EMAIL_PROVIDER=console
EMAIL_FROM="Береке ТехСервис <no-reply@tisei.kz>"

GEO_PROVIDER=yandex
YANDEX_GEOCODER_API_KEY=
TWOGIS_API_KEY=

RECAPTCHA_SECRET=
PUBLIC_REQUEST_RATE_MAX=5
PUBLIC_REQUEST_RATE_WINDOW=1 minute
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW=1 minute
SOFT_DELETE_RETENTION_DAYS=30
