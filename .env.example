# =============================================================================
# TiSei — production environment (Docker Compose)
# Copy to .env in the repository root and fill in real values.
# =============================================================================

# ── PostgreSQL (docker-compose service: postgres) ────────────────────────────
POSTGRES_USER=tisei
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=tisei

# ── Public URLs (Nginx Proxy Manager + Let's Encrypt) ─────────────────────────
# Used for CORS, cookies, emails, and Next.js build-time public API URL.
API_BASE_URL=https://api.tisei.kz
FRONTEND_CRM_URL=https://crm.tisei.kz
FRONTEND_LANDING_URL=https://tisei.kz

# Browser-facing API URL (baked into Next.js at build time)
NEXT_PUBLIC_API_URL=https://api.tisei.kz/api/v1

# Server-side API URL inside Docker network (landing → backend)
BACKEND_INTERNAL_URL=http://backend:4000/api/v1

# Yandex Maps key for CRM (optional, baked at CRM build time)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# ── Backend application ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Internal URLs (overridden in docker-compose.prod.yml for containers)
DATABASE_URL=postgresql://tisei:change-me-strong-postgres-password@postgres:5432/tisei?schema=public
REDIS_URL=redis://host.docker.internal:6379

# ── JWT / Auth (generate: openssl rand -base64 48) ───────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SESSION_IDLE_MINUTES=480
PASSWORD_RESET_TTL_MINUTES=60
TOTP_ISSUER=Береке ТехСервис CRM

# ── AWS S3 (attachments) ─────────────────────────────────────────────────────
S3_REGION=eu-central-1
S3_BUCKET=tisei-attachments-prod
S3_ACCESS_KEY_ID=your-aws-access-key-id
S3_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=https://tisei-attachments-prod.s3.eu-central-1.amazonaws.com

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM="Береке ТехСервис <no-reply@tisei.kz>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@tisei.kz

# Firebase Cloud Messaging (mobile)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Geocoding / Maps ───────────────────────────────────────────────────────────
GEO_PROVIDER=yandex
TWOGIS_API_KEY=
YANDEX_GEOCODER_API_KEY=
YANDEX_MAPS_API_KEY=

# ── reCAPTCHA (public lead form) ─────────────────────────────────────────────
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# ── Rate limiting ────────────────────────────────────────────────────────────
PUBLIC_REQUEST_RATE_MAX=5
PUBLIC_REQUEST_RATE_WINDOW=1 minute
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW=1 minute

# ── Maintenance ──────────────────────────────────────────────────────────────
SOFT_DELETE_RETENTION_DAYS=30
